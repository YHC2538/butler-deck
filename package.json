{
  "name": "butler-of-everything-proposal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev --open",
    "build": "slidev build",
    "build:pages": "rimraf dist && slidev build --base /butler-deck/",
    "deploy": "rimraf dist && slidev build --base /butler-deck/ && gh-pages -d dist --dotfiles --nojekyll",
    "export": "slidev export --output butler-of-everything-proposal.pdf",
    "export-pptx": "slidev export --format pptx --output butler-of-everything-proposal.pptx"
  },
  "dependencies": {
    "@slidev/cli": "latest",
    "@slidev/theme-default": "latest",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "playwright-chromium": "latest",
    "rimraf": "^6.1.4"
  }
}
